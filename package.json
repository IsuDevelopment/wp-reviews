{
	"name": "@isudev/reviews",
	"version": "0.3.1",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-src-dir=src --output-path=build --blocks-manifest",
		"start": "wp-scripts start --webpack-src-dir=src --output-path=build --blocks-manifest",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\" \"templates/**/*.css\" \"assets/**/*.css\"",
		"format": "wp-scripts format src",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"files": [
		"isudev-reviews.php",
		"uninstall.php",
		"includes",
		"templates",
		"assets",
		"build",
		"languages",
		"vendor-prefixed",
		"readme.txt"
	],
	"devDependencies": {
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/scripts": "^31.8.0",
		"@wordpress/server-side-render": "^6.33.0",
		"typescript": "^5.9.3"
	}
}
