<?xml version="1.0"?>
<ruleset name="IsuDev Reviews">
	<description>IsuDev Reviews coding standards.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/vendor-prefixed/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<!-- Dev tooling run with plain PHP, not shipped (bin/code-map.php). -->
	<exclude-pattern>/bin/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<!-- Block render.php and template card.php files follow block/template naming, not class naming. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/templates/*</exclude-pattern>
		<exclude-pattern>/includes/admin/views/*</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="isudev-reviews"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="isurev"/>
				<element value="IsuDev\Reviews"/>
			</property>
		</properties>
	</rule>
</ruleset>
