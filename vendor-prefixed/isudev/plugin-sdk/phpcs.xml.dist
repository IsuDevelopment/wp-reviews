<?xml version="1.0"?>
<ruleset name="isuDev Plugin SDK">
	<description>isuDev Plugin SDK coding standards.</description>

	<file>./src</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
	</rule>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="isudev-plugin-sdk"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="isudev"/>
				<element value="IsuDev\PluginSdk"/>
			</property>
		</properties>
	</rule>
</ruleset>
